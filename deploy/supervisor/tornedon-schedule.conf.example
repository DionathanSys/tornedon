[program:tornedon-schedule]
process_name=%(program_name)s
directory=/var/www/tornedon
command=/usr/bin/php artisan schedule:work
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
redirect_stderr=true
stdout_logfile=/var/www/tornedon/storage/logs/schedule.log
stopwaitsecs=60
